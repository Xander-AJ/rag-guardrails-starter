# Copy to .env and fill in your values.
# Loaded automatically by rag_guardrails.config.Settings (case-insensitive).

# --- Provider selection ---
# One of: openai | openrouter | langchain
PROVIDER=openai
MODEL_NAME=gpt-4o-mini

# --- Provider credentials ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
# Local Ollama server (no API key required)
OLLAMA_BASE_URL=http://localhost:11434

# --- Vector store (Qdrant) ---
# For local Qdrant: http://localhost:6333
QDRANT_URL=
QDRANT_COLLECTION=rag_documents

# --- Memory ---
# Number of recent conversation turns to retain
MEMORY_WINDOW=10

# --- Guardrail toggles ---
INPUT_GUARD_ENABLED=true
OUTPUT_GUARD_ENABLED=true
EMERGENCY_DETECTION_ENABLED=true
# Minimum grounding score (0.0-1.0) a response must meet
HALLUCINATION_THRESHOLD=0.7
